# Normalize line endings: text files are stored as LF in the repo,
# checked out with the platform-native endings on each OS.
* text=auto

# Windows scripts should keep CRLF when checked out on Windows
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files (never touch line endings / diff)
*.ico binary
*.png binary
*.jpg binary
*.exe binary
*.msix binary
*.zip binary
*.cer binary