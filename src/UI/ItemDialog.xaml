<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Item" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="24,20,24,20">
    <TextBlock x:Name="itmTitle" Text="New status" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,16"/>

    <TextBlock x:Name="itmHint" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,-6,0,14" Visibility="Collapsed"/>

    <TextBlock Text="Name *" Style="{StaticResource FieldLabel}"/>
    <TextBox x:Name="itmName" MaxLength="40"/>

    <StackPanel x:Name="itmValuePanel" Margin="0,14,0,0" Visibility="Collapsed">
      <TextBlock x:Name="itmValueLabel" Text="Numeric value (higher = more important) *" Style="{StaticResource FieldLabel}"/>
      <TextBox x:Name="itmValue" MaxLength="8"/>
    </StackPanel>

    <StackPanel x:Name="itmColorPanel">
      <TextBlock Text="Color *" Style="{StaticResource FieldLabel}" Margin="2,14,0,5"/>
      <WrapPanel x:Name="itmPalette"/>
      <Grid Margin="0,10,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="itmPreview" Width="34" Height="34" CornerRadius="8" Margin="0,0,10,0"/>
        <TextBox x:Name="itmColor" Grid.Column="1" MaxLength="7" FontFamily="Cascadia Mono, Consolas"/>
      </Grid>
    </StackPanel>

    <CheckBox x:Name="itmClosed" Content="Closed status (excluded from the priority ranking)" Margin="2,16,0,0" Visibility="Collapsed"/>

    <TextBlock x:Name="itmError" Foreground="{DynamicResource DangerBrush}" Margin="2,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button x:Name="itmCancel" Content="Cancel" MinWidth="90" Margin="0,0,8,0"/>
      <Button x:Name="itmSave" Content="Save" Style="{StaticResource PrimaryButton}" MinWidth="100"/>
    </StackPanel>
  </StackPanel>
</Window>
