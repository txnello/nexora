<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task" Width="980" Height="690" MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="24,20,24,18">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="320"/>
      <ColumnDefinition x:Name="colSide" Width="300"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock x:Name="dlgTitle" Grid.ColumnSpan="2" Text="New task" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,16"/>

    <!-- Form -->
    <ScrollViewer x:Name="taskFormScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0">
      <StackPanel Margin="0,0,16,0">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Code *" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="txtCode" MaxLength="25" FontFamily="Cascadia Mono, Consolas"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Title *" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="txtTitle" MaxLength="200"/>
          </StackPanel>
        </Grid>

        <TextBlock Text="Description" Style="{StaticResource FieldLabel}" Margin="2,14,0,5"/>
        <TextBox x:Name="txtDesc" Height="110" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto" Padding="10,8"/>

        <TextBlock Text="Link" Style="{StaticResource FieldLabel}" Margin="2,14,0,5"/>
        <TextBox x:Name="txtLink" MaxLength="2048" ToolTip="Only absolute HTTP or HTTPS links are supported."/>

        <Grid Margin="0,14,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Project" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="cmbProject" IsEditable="False">
              <ComboBox.ItemTemplate><DataTemplate>
                <TextBlock Text="{Binding name}"/>
              </DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Owner" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="cmbReferent" IsEditable="False">
              <ComboBox.ItemTemplate><DataTemplate>
                <TextBlock Text="{Binding name}"/>
              </DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
        </Grid>

        <Grid Margin="0,14,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Status *" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="cmbStatus">
              <ComboBox.ItemTemplate><DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="9" Height="9" Fill="{Binding color}" Margin="0,1,9,0"/><TextBlock Text="{Binding name}"/>
                </StackPanel>
              </DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Manual priority *" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="cmbPriority">
              <ComboBox.ItemTemplate><DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="9" Height="9" Fill="{Binding color}" Margin="0,1,9,0"/><TextBlock Text="{Binding name}"/>
                </StackPanel>
              </DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
        </Grid>

        <Grid Margin="0,14,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Due date" Style="{StaticResource FieldLabel}"/>
            <Grid>
              <TextBox x:Name="txtDue" Padding="10,7,38,7"/>
              <TextBlock x:Name="dueHint" Text="none" Style="{StaticResource Muted}" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
              <Button x:Name="btnCal" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Padding="9,0" Width="34" Margin="0,2,2,2" ToolTip="Open calendar">
                <TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFont}" FontSize="13"/>
              </Button>
              <Popup x:Name="calPopup" PlacementTarget="{Binding ElementName=btnCal}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,4,10,10">
                  <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.35"/></Border.Effect>
                  <Calendar x:Name="calendar" BorderThickness="0"/>
                </Border>
              </Popup>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button x:Name="btnToday" Content="Today" Style="{StaticResource ChipButton}" Margin="0,0,6,0"/>
              <Button x:Name="btnTomorrow" Content="Tomorrow" Style="{StaticResource ChipButton}" Margin="0,0,6,0"/>
              <Button x:Name="btnWeek" Content="+7 days" Style="{StaticResource ChipButton}" Margin="0,0,6,0"/>
              <Button x:Name="btnNoDue" Content="None" Style="{StaticResource ChipButton}"/>
            </StackPanel>
          </StackPanel>
        </Grid>

        <TextBlock x:Name="txtMeta" Style="{StaticResource Muted}" FontSize="12" Margin="2,18,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="txtError" Foreground="{DynamicResource DangerBrush}" Margin="2,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
      </StackPanel>
    </ScrollViewer>

    <!-- Side panel -->
    <Grid x:Name="sidePanel" Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

      <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
        <StackPanel>
          <Grid>
            <TextBlock Text="Priority score" Style="{StaticResource Muted}"/>
            <TextBlock x:Name="txtScore" Text="—" FontSize="26" FontWeight="Bold" HorizontalAlignment="Right"/>
          </Grid>
          <ProgressBar x:Name="barScore" Style="{StaticResource ThinBar}" Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,10"/>
          <TextBlock x:Name="txtBreakdown" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" LineHeight="19"/>
        </StackPanel>
      </Border>

      <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
        <StackPanel>
          <Grid>
            <TextBlock Text="Reminders received" Style="{StaticResource Muted}"/>
            <TextBlock x:Name="txtRemCount" Text="0" FontSize="22" FontWeight="Bold" HorizontalAlignment="Right"/>
          </Grid>
          <TextBlock x:Name="txtRemLast" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,10" Text="No reminders"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="btnRemind" Style="{StaticResource PrimaryButton}">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7ED;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0"/><TextBlock Text="Log reminder"/></StackPanel>
            </Button>
            <Button x:Name="btnUnRemind" Grid.Column="1" Margin="6,0,0,0" ToolTip="Undo the last reminder (misclick)">
              <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource IconFont}"/>
            </Button>
          </Grid>
        </StackPanel>
      </Border>

      <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,14,16,10">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="History" Style="{StaticResource Muted}" Margin="0,0,0,8"/>
          <ListBox x:Name="lstHistory" BorderThickness="0">
            <ListBox.ItemTemplate><DataTemplate>
              <StackPanel Margin="0,2">
                <TextBlock Text="{Binding text}" TextWrapping="Wrap" FontSize="12.5"/>
                <TextBlock Text="{Binding when}" Style="{StaticResource Muted}" FontSize="11"/>
              </StackPanel>
            </DataTemplate></ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="IsHitTestVisible" Value="False"/>
              </Style>
            </ListBox.ItemContainerStyle>
          </ListBox>
        </DockPanel>
      </Border>
    </Grid>

    <!-- Buttons -->
    <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,16,0,0" LastChildFill="False">
      <Button x:Name="btnDelete" DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Foreground="{DynamicResource DangerBrush}">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" Margin="0,1,7,0"/><TextBlock Text="Delete"/></StackPanel>
      </Button>
      <Button x:Name="btnSave" DockPanel.Dock="Right" Content="Save" Style="{StaticResource PrimaryButton}" MinWidth="110" IsDefault="False"/>
      <Button x:Name="btnCancel" DockPanel.Dock="Right" Content="Cancel" Margin="0,0,8,0" MinWidth="90"/>
    </DockPanel>
  </Grid>
</Window>
