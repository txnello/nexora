<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About NEXORA" Width="540" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="34,30,34,26">
    <Image x:Name="aboutLogo" Height="66" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
    <TextBlock x:Name="aboutVersion" Style="{StaticResource Muted}" Margin="2,14,0,0"/>

    <TextBlock Text="Intelligent task management system" FontSize="18" FontWeight="SemiBold" Margin="0,20,0,6" TextWrapping="Wrap"/>
    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="20"
               Text="NEXORA automatically calculates which tasks deserve your attention first, based on priority, due date, reminders and age. All your data stays on this computer."/>

    <Button x:Name="aboutDonate" Style="{StaticResource DonateButton}" HorizontalAlignment="Left" Margin="0,16,0,0" ToolTip="Support NEXORA with a donation">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="&#x2665;" FontSize="14" VerticalAlignment="Center" Foreground="#FF6B9D"/>
        <TextBlock Text="Support NEXORA" VerticalAlignment="Center" Margin="8,0,0,0"/>
      </StackPanel>
    </Button>

    <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,20,0,0">
      <StackPanel>
        <TextBlock Text="Data folder" Style="{StaticResource FieldLabel}"/>
        <TextBlock x:Name="aboutData" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
        <Button x:Name="aboutChangeData" Content="Change folder…" HorizontalAlignment="Left" Margin="0,10,0,0"/>
      </StackPanel>
    </Border>

    <TextBlock x:Name="aboutCopy" Style="{StaticResource Muted}" FontSize="12" Margin="2,18,0,0" TextWrapping="Wrap"/>
    <Button x:Name="aboutWebsite" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="0" Margin="2,6,0,0">
      <TextBlock Text="Developed by Manuel Tonello · txnello.com" TextDecorations="Underline" Foreground="{DynamicResource AccentBrush}"/>
    </Button>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
      <Button x:Name="aboutOpenData" Content="Open data folder" Margin="0,0,8,0"/>
      <Button x:Name="aboutClose" Content="Close" Style="{StaticResource PrimaryButton}" MinWidth="100"/>
    </StackPanel>
  </StackPanel>
</Window>
